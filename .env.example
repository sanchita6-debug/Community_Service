# ============================================================================
# VoicePay - single environment file
# ============================================================================
# This file is OPTIONAL. VoicePay works with no `.env` at all: `npm run dev`
# runs the client on localStorage and the API with an in-memory store. Copy it
# only if you want to change a default:
#
#   Copy-Item .env.example .env
#
# This ONE file is read by BOTH sides:
#   - the Vite client, because client/vite.config.js sets `envDir` to the root
#   - the Express server, because server/src/env.js loads this exact path
#
# Vite only exposes `VITE_`-prefixed names to the browser bundle.
#
# There are no secrets here and nothing to sign up for. Everything the user
# chooses - language, text size, voice speed, trusted payee names, progress -
# is written to their own browser's localStorage first and only then synced to
# the API, which keeps its copy in memory and forgets it when it restarts.
# ============================================================================


# --- Client: how to reach the API ---------------------------------------------
# Leave as /api to use the Vite dev proxy. Set a full URL in production.
VITE_API_URL=/api

# Where the dev server proxies /api to (read by vite.config.js, not the app).
VITE_API_PROXY=http://localhost:4000

# Shown on the Settings screen.
VITE_APP_VERSION=1.0.0


# --- Server ---------------------------------------------------------------------
# Port the API listens on (the Vite dev server proxies /api here).
PORT=4000

# Where the React client is served from. Comma-separate for multiple origins.
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
