{
  "name": "voicepay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VoicePay - Easy UPI for Everyone. A voice-guided assistive layer that helps elderly and low-literacy Indian users understand and safely perform common UPI tasks.",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/src/index.js",
    "preview": "vite preview --config client/vite.config.js --port 4173",
    "lint": "eslint client/src server/src shared --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit -p client/tsconfig.json",
    "verify": "npm run verify:rules && npm run verify:parser && npm run verify:i18n && npm run verify:voice && npm run verify:typecheck && npm run verify:api && npm run verify:family",
    "verify:rules": "node scripts/verify-rules.mjs",
    "verify:parser": "node scripts/verify-parser.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:voice": "node scripts/verify-voice.mjs",
    "verify:typecheck": "npm run typecheck",
    "verify:api": "node scripts/smoke-api.mjs",
    "verify:family": "node scripts/verify-family.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "framer-motion": "^11.2.10",
    "helmet": "^7.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "tailwind-merge": "^2.6.1",
    "tesseract.js": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^8.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.2.13",
    "vite-plugin-pwa": "^0.20.0",
    "workbox-build": "^7.4.1"
  },
  "engines": {
    "node": ">=18.17"
  },
  "license": "MIT"
}
